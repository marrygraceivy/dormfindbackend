APP_NAME=DormFind
APP_ENV=development
APP_URL=http://localhost:8000/
# Generate these locally with php lava key:generate and php lava jwt:generate.
# For Render, use three different secret values (at least 32 random characters each).
APP_KEY=
JWT_SECRET=
REFRESH_TOKEN_KEY=
FRONTEND_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:4173
DB_DRIVER=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=dormfind_db
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
# Use true for a remote production database. Render defaults to true.
DB_SSL_REQUIRED=false
# Render example: /etc/secrets/ca.pem (provider's CA certificate).
DB_SSL_CA=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_DEV_BYPASS=false
MAPBOX_PUBLIC_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Render example: /etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=DormFind
